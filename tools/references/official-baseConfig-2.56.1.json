  "sourceModelSyncConfig": {
    "findXbsLink": {
      "responseJavascript": "function functionName(config, params, resStr)\n{\n\tvar list = [];\n\n\tlet host = '';\n\tvar regHost = /(https?:\\/\\/[^/]+)\\//i;\n\tif(tem=regHost.exec(params.responseUrl))\n\t\thost=tem[1];\n\n\n\tvar reg1 = /(http[^\"<> ]+?.xbs).*?/gim;\n    \twhile(tem=reg1.exec(resStr)) {\n\t\tlist.push(tem[1]);\n\t}\n\n\n\tvar reg2 = /href=\"(.*?.xbs)\"/gim;\n    \twhile(tem=reg2.exec(resStr)) {\n\t\tlet url = tem[1];\n\t\tif(url.indexOf('http')!=0){\n\t\t\tif(url.indexOf('/')!=0)\n\t\t\t\turl = host + '/' + url;\n\t\t\telse\n\t\t\t\turl = host + url;\n\t\t}\n\t\tlist.push(url);\n\t}\n\n\n\treturn list;\n}",
      "validConfig": "",
      "actionID": "findXbsLink",
      "responseFunction": "functionName",
      "requestFunction": "functionName",
      "requestJavascript": "function functionName(config, params) {\n\treturn {\"url\":params.url, \"forbidCookie\":true};\n}",
      "parserID": "JS"
    },
    "queryXbsFile": {
      "validConfig": "",
      "requestJavascript": "function functionName(config, params) \n{\n\tvar url = params.url;\n\tif(url.indexOf(\"github.com\")>0 || url.indexOf(\"gitee.com\")>0){\n\t\tif(url.indexOf(\"/blob/\")>0)\n\t\t\turl = url.replace(\"/blob/\", \"/raw/\");\n\t}\n\treturn {\"url\":url, \"forbidCookie\":true};\n}",
      "actionID": "queryXbsFile",
      "requestFunction": "functionName",
      "responseFormatType": "json",
      "parserID": "JS",
      "responseDecryptType": "encryptType1"
    }
  },
